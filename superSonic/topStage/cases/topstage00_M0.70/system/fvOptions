/*--------------------------------*- C++ -*----------------------------------*\
  topstage wing sweep, Mach 0.70 - generated by make_sweep_cases.py
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Start-up guards for the impulsive Mach 0.7 start: the first iterations put
// near-wall layer cells far out of range before the flow settles. Both limits
// sit well outside anything the converged field reaches (T_stag ~ 316 K,
// local Mach < ~1.3), so they do not touch the answer.
limitT
{
    type            limitTemperature;
    active          yes;
    selectionMode   all;
    min             150;
    max             500;
}

limitU
{
    type            limitVelocity;
    active          yes;
    selectionMode   all;
    max             500;
}
