/*--------------------------------*- C++ -*----------------------------------*\
  topstage wing sweep, Mach 0.70 - generated by make_sweep_cases.py
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     rhoSimpleFoam;

startFrom       latestTime;
startTime       0;
stopAt          writeNow;
endTime          1e+09;
deltaT          1;

writeControl    timeStep;
writeInterval          500;
purgeWrite          20;

writeFormat    binary;
writePrecision          8;
writeCompression    off;
timeFormat    general;
timePrecision   6;
runTimeModifiable true;

functions
{
    continuityError
    {
        type            continuityError;
        libs            (fieldFunctionObjects);
        writeControl    timeStep;
        writeInterval   1;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    #includeFunc forceCoeffs1
    #includeFunc forces1

    residuals
    {
        type            solverInfo;
        libs            (utilityFunctionObjects);
        fields          (U p e k omega);
    }

    MachNo
    {
        type            MachNo;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }

    yPlus
    {
        type            yPlus;
        libs            (fieldFunctionObjects);
        writeControl    writeTime;
    }
}
