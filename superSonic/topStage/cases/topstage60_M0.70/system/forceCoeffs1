FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      forceCoeffs1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Same reference values for every sweep angle, so the coefficients compare
// directly: Aref = body frontal area (r = 0.049 m), lRef = body length,
// CofR = flight cg (Mach 0.7 row), lift/drag normal/parallel to the 0.0 deg freestream.

type            forceCoeffs;
libs            (forces);
log             true;
writeControl    timeStep;
writeInterval   1;
patches         (nose fuselagewing fuselagepiece finhousing bodyFins leftwing rightwing);
rho             rho;
rhoInf          1.22501;
pRef            101325.0;
CofR            (0 0 -0.519155);
liftDir         (0 1 0);
dragDir         (0 0 -1);
pitchAxis       (1 0 0);
magUInf         238.2046;
lRef            0.9660;
Aref            7.542964e-03;
