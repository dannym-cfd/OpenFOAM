/*--------------------------------*- C++ -*----------------------------------*\
  topstage wing sweep, Mach 0.70 - generated by make_sweep_cases.py
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "rho.*"
    {
        solver          diagonal;
    }
    "p.*"
    {
        solver          GAMG;
        smoother        GaussSeidel;
        tolerance       1e-7;
        relTol          0.01;
    }
    "(U|e|k|omega).*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-7;
        relTol          0.1;
    }
}

// Pseudo-transient: rhoPimpleFoam with local time stepping (ddtSchemes
// localEuler) - each cell marches at its own Courant-limited step toward
// the steady state. transonic: the pressure equation for the supersonic
// pockets M0.7 makes over the wings and the nose shoulder.
PIMPLE
{
    momentumPredictor       yes;
    transonic               yes;
    nOuterCorrectors        1;
    nCorrectors             2;
    nNonOrthogonalCorrectors 1;    // faces up to ~75 deg non-orthogonal
    pMinFactor              0.1;
    pMaxFactor              2;

    maxCo                   0.5;    // raise toward 1-2 once it runs smoothly
    rDeltaTSmoothingCoeff   0.02;
    rDeltaTDampingCoeff     1;
    maxDeltaT               1;
}

relaxationFactors
{
    equations
    {
        ".*"            1;
    }
}

// ************************************************************************* //
