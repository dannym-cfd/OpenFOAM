/*--------------------------------*- C++ -*----------------------------------*\
  topstage wing sweep, Mach 0.70 - generated by make_sweep_cases.py
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;

geometry
{
    nose.stl
    {
        type triSurfaceMesh;
        name nose;
    }
    fuselagewing.stl
    {
        type triSurfaceMesh;
        name fuselagewing;
    }
    fuselagepiece.stl
    {
        type triSurfaceMesh;
        name fuselagepiece;
    }
    finhousing.stl
    {
        type triSurfaceMesh;
        name finhousing;
    }
    bodyFins.stl
    {
        type triSurfaceMesh;
        name bodyFins;
    }
    leftwing.stl
    {
        type triSurfaceMesh;
        name leftwing;
    }
    rightwing.stl
    {
        type triSurfaceMesh;
        name rightwing;
    }
    nearBox   { type searchableBox; min (-0.50 -0.30 -1.30); max (0.50 0.30 0.15); }
    wakeBox   { type searchableBox; min (-0.70 -0.50 -3.00); max (0.70 0.50 0.30); }
    farBox    { type searchableBox; min (-1.50 -1.50 -6.00); max (1.50 1.50 1.50); }

    // Tip-vortex paths: a cylinder from each wingtip and fin tip, from the
    // tip's leading edge to z = -2.5 (about two body lengths behind the
    // wing), so the vortices stay resolved downstream instead of smearing
    // out in the wake box's 31 mm cells.
    vortexWingL { type searchableCylinder; point1 ( 0.348 0.004 -0.51); point2 ( 0.348 0.004 -2.5); radius 0.04; }
    vortexWingR { type searchableCylinder; point1 (-0.348 0.004 -0.51); point2 (-0.348 0.004 -2.5); radius 0.04; }
    vortexFinXp { type searchableCylinder; point1 ( 0.150 0 -0.90); point2 ( 0.150 0 -2.5); radius 0.03; }
    vortexFinXm { type searchableCylinder; point1 (-0.150 0 -0.90); point2 (-0.150 0 -2.5); radius 0.03; }
    vortexFinYp { type searchableCylinder; point1 (0  0.150 -0.90); point2 (0  0.150 -2.5); radius 0.03; }
    vortexFinYm { type searchableCylinder; point1 (0 -0.150 -0.90); point2 (0 -0.150 -2.5); radius 0.03; }
}

castellatedMeshControls
{
    maxLocalCells       4000000;
    maxGlobalCells      30000000;
    minRefinementCells  10;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;

    features
    (
        { file "nose.eMesh"; level 8; }
        { file "fuselagewing.eMesh"; level 8; }
        { file "fuselagepiece.eMesh"; level 8; }
        { file "finhousing.eMesh"; level 8; }
        { file "bodyFins.eMesh"; level 8; }
        { file "leftwing.eMesh"; level 9; }
        { file "rightwing.eMesh"; level 9; }
        { file "wingJunction.eMesh"; level 9; }
    );

    refinementSurfaces
    {
        nose
        {
            level (8 8);
            patchInfo { type wall; inGroups (vehicle); }
        }
        fuselagewing
        {
            level (8 8);
            patchInfo { type wall; inGroups (vehicle); }
        }
        fuselagepiece
        {
            level (8 8);
            patchInfo { type wall; inGroups (vehicle); }
        }
        finhousing
        {
            level (8 8);
            patchInfo { type wall; inGroups (vehicle); }
        }
        bodyFins
        {
            level (7 8);
            patchInfo { type wall; inGroups (vehicle); }
        }
        leftwing
        {
            level (8 9);
            patchInfo { type wall; inGroups (vehicle); }
        }
        rightwing
        {
            level (8 9);
            patchInfo { type wall; inGroups (vehicle); }
        }
    }

    resolveFeatureAngle 30;

    refinementRegions
    {
        nearBox { mode inside; levels ((1e15 4)); }
        wakeBox { mode inside; levels ((1e15 3)); }
        farBox  { mode inside; levels ((1e15 2)); }
        // Level 6: ~3.9 mm cells along the vortex paths (the wake box is level 3, ~31 mm).
        "vortex.*" { mode inside; levels ((1e15 6)); }
    }

    locationInMesh (-4.013 -4.037 3.111);
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch        3;
    tolerance           2.0;
    nSolveIter          50;
    nRelaxIter          5;
    nFeatureSnapIter    10;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes       true;
    layers
    {
        "(nose|fuselagewing|fuselagepiece|finhousing|bodyFins|leftwing|rightwing)"
        {
            nSurfaceLayers 5;
        }
    }
    expansionRatio      1.2;
    finalLayerThickness 0.4;
    minThickness        0.05;
    nGrow               0;
    featureAngle        130;
    slipFeatureAngle    30;
    nRelaxIter          5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals      3;
    nSmoothThickness    10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle  90;
    nBufferCellsNoExtrude 0;
    nLayerIter          50;
    nRelaxedIter        20;
}

meshQualityControls
{
    maxNonOrtho         65;
    maxBoundarySkewness 4;   // was 20: checkMesh fails faces over 4, so snappy should not make them
    maxInternalSkewness 4;
    maxConcave          80;
    minVol              1e-13;
    minTetQuality       1e-15;
    minArea             -1;
    minTwist            0.02;
    minDeterminant      0.001;
    minFaceWeight       0.05;
    minVolRatio         0.01;
    minTriangleTwist    -1;
    nSmoothScale        4;
    errorReduction      0.75;
    relaxed
    {
        maxNonOrtho     75;
    }
}

mergeTolerance 1e-6;
